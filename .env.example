# Parking Reminder v2.0.1 Configuration
# Copy this file to .env and configure with your values

# Webhook Base URL
# Change this to your server's IP or domain
WEBHOOK_BASE_URL=http://YOUR_SERVER_IP:8085

# ntfy Server Configuration
NTFY_SERVER=https://ntfy.yourdomain.com
NTFY_TOPIC=parking
NTFY_AUTH_USER=your_username
NTFY_AUTH_PASS=your_secure_password

# Failsafe notification (cloud ntfy.sh as backup)
# Use a random suffix for security
NTFY_FAILSAFE_TOPIC=parking_your_username_RANDOM_STRING

# Twilio Configuration (sign up at twilio.com)
# Leave blank to disable SMS/phone escalation
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_TO_PHONE=

# Uptime Kuma Push Monitor URL (optional)
# Create push monitor in Uptime Kuma and paste URL here
UPTIME_KUMA_PUSH_URL=
